{
    "name": "reinfyteam/bedrockvoicechat",
    "description": "Fully asynchronous Bedrock Voice Chat (bedrockvoicechat.com) integration for PocketMine-MP servers.",
    "license": "LGPL-2.1-only",
    "type": "pocketmine-plugin",
    "repositories": [
		{
            "type": "vcs",
            "url": "https://github.com/NhanAZ-Libraries/FormAPI/"
        },
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "scripts": {
        "analyze": "vendor/bin/phpstan analyse src --level=max",
        "build": "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -p=BedrockVoiceChat.phar",
        "build-source": "php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -o=./output/"
    },
    "autoload": {
        "psr-4": {
            "ReinfyTeam\\BedrockVoiceChat\\": "src/ReinfyTeam/BedrockVoiceChat/"
        }
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.51.1",
        "sof3/pharynx": "^0.3.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
	"require": {
		"paroxity/commando": "dev-master",
		"muqsit/simple-packet-handler": "0.1.6",
		"jojoe77777/libformapi": "dev-main"
	}
}
